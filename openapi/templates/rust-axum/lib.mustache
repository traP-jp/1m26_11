    }
}

impl std::fmt::Display for NullValue {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter.write_str("null")
    }
}

impl std::str::FromStr for NullValue {
    type Err = String;

    fn from_str(value: &str) -> Result<Self, Self::Err> {
        if value == "null" {
            Ok(Self)
